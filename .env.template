# Copia este archivo a .env y completa los valores reales. NO subas .env al repositorio.

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Correo que recibe los mensajes del formulario de contacto.
# Con el remitente de prueba de Resend debe ser el correo de tu cuenta de Resend.
CONTACT_TO_EMAIL=tu-correo@ejemplo.com

# Remitente. onboarding@resend.dev es el dominio de prueba de Resend.
CONTACT_FROM_EMAIL=Arcade Vault <onboarding@resend.dev>

# URL del proyecto de Supabase (Project Settings > API). Es pública.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anon / publishable del proyecto (Project Settings > API). Es pública.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon

# Clave service_role de Supabase. Ignora RLS: solo servidor, nunca con prefijo NEXT_PUBLIC_.
# Se deja vacía; ningún código la usa todavía.
SUPABASE_SERVICE_ROLE_KEY=